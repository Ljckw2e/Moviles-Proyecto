<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/bottom_home">

    <fragment
        android:id="@+id/bottom_home"
        android:name="com.example.proyecto.HomeFragment"
        android:label="Organizador de Eventos" />

    <fragment
        android:id="@+id/nav_add_event"
        android:name="com.example.proyecto.AddEventFragment"
        android:label="Añadir Eventos" />

    <fragment
        android:id="@+id/nav_consult_event"
        android:name="com.example.proyecto.ConsultFragment"
        android:label="Consultar Eventos" />

    <fragment
        android:id="@+id/nav_calendar"
        android:name="com.example.proyecto.CalendarFragment"
        android:label="Calendario" />

    <fragment
        android:id="@+id/nav_backup"
        android:name="com.example.proyecto.BackupFragment"
        android:label="Respaldo">
        <argument
            android:name="restaurar"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/nav_restore"
        android:name="com.example.proyecto.BackupFragment"
        android:label="Restaurar datos">
        <argument
            android:name="restaurar"
            android:defaultValue="true"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.example.proyecto.SettingsFragment"
        android:label="Configuración" />

    <fragment
        android:id="@+id/nav_about"
        android:name="com.example.proyecto.AboutFragment"
        android:label="Acerca de.." />
</navigation>
